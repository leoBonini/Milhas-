# ------------------------------------------------------------------
# Copie para .env e preencha. Nunca faça commit do .env.
# ------------------------------------------------------------------

# Supabase (Fase 1 em diante)
# URL do projeto: Supabase > Project Settings > API
SUPABASE_URL=
# Chave service_role: usada SÓ pelos jobs de coleta (servidor/Actions). Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Chave anon: usada pelo app (só leitura, protegida por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Coleta
# User agent identificável enviado pelos coletores. Coloque um contato real.
COLETA_USER_AGENT="MilhasBot/0.1 (+mailto:contato@exemplo.com)"
# Intervalo mínimo entre requisições ao mesmo site, em milissegundos
COLETA_INTERVALO_MS=3000

# Web Push (Fase 4) — gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com

# Pagamento (Fase 5) — Stripe OU Mercado Pago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
